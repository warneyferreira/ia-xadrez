# Preserve raw evidence bytes and SHA-256 across Windows/Linux checkouts.
*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
*.jsonl -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# A PGN stream ends each game, including the last, with a blank separator.
*.pgn -text whitespace=blank-at-eol,space-before-tab,cr-at-eol
